# Copy to .env and fill in. Never commit the real .env.
PORT=5001
DB_URL=

# Session tokens. Required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Firebase project used to verify Google sign-in (defaults to you-tube-ece31)
FIREBASE_PROJECT_ID=

# OTP via SMS
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OTP via email (Gmail app password)
EMAIL_USER=
EMAIL_PASS=

# Media storage. Leave empty to store uploads on local disk (./uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Extra frontend origins allowed by CORS and Socket.IO, comma-separated
CLIENT_URL=

# One-click shared demo account ("Try demo" button). Set to false to disable.
ENABLE_DEMO_LOGIN=true

# YouTube Data API v3 key: shows real YouTube videos on home, search and watch.
# Get one at https://console.cloud.google.com (enable "YouTube Data API v3").
YOUTUBE_API_KEY=
# Country for trending videos and search results (ISO 3166-1 alpha-2).
YOUTUBE_REGION=IN
